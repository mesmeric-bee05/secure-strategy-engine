# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
LOVABLE_API_KEY="your-lovable-api-key-here"

# These are injected into the client bundle by Vite
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
